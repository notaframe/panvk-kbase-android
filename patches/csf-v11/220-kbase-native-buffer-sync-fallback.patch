From: LukeValen <panvk@localhost>
Subject: [PATCH] panvk: use CPU sync export for native-buffer presentation on kbase

--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -494,7 +494,14 @@
    device->vk.shader_ops = &panvk_per_arch(device_shader_ops);
    device->vk.check_status = panvk_device_check_status;
    device->vk.get_timestamp = panvk_device_get_timestamp;
+#ifdef HAVE_PAN_KMOD_KBASE
+   /* Kbase sync objects are CPU syncs, not DRM syncobjs. */
+   device->vk.copy_sync_payloads = physical_device->kbase_node_path[0]
+                                      ? NULL
+                                      : vk_drm_syncobj_copy_payloads;
+#else
    device->vk.copy_sync_payloads = vk_drm_syncobj_copy_payloads;
+#endif
 
    device->kmod.allocator = (struct pan_kmod_allocator){
       .zalloc = panvk_kmod_zalloc,
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1062,60 +1062,18 @@
                                 int *sync_file)
 {
    struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
-   struct panvk_device *dev = to_panvk_device(device);
-   uint64_t addrs[PANVK_KBASE_SYNC_TARGET_COUNT];
-   uint64_t vals[PANVK_KBASE_SYNC_TARGET_COUNT];
-   unsigned count = 0;
-   int fd;
-
-   VkResult result =
-      kbase_cpu_sync_wait_one(device, ks, VK_SYNC_WAIT_PENDING, UINT64_MAX);
+
+   /* Complete this sync before returning Android's already-signaled fence.
+    * Avoid both DRM syncobj ioctls (not available on /dev/mali0) and the
+    * experimental KCPU CQS fence exporter. The common Vulkan export path
+    * still handles binary semaphore payload reset and temporary imports.
+    */
+   VkResult result = kbase_cpu_sync_wait_one(device, ks, VK_SYNC_WAIT_COMPLETE,
+                                             UINT64_MAX);
    if (result != VK_SUCCESS)
       return result;
 
-   mtx_lock(&ks->mutex);
-   if (ks->state == KBASE_CPU_SYNC_PENDING ||
-       ks->state == KBASE_CPU_SYNC_WAITING) {
-      if (ks->pending_wait == kbase_sync_file_wait_func) {
-         struct kbase_sync_file_waiter *waiter = ks->pending_data;
-         fd = dup(waiter->fd);
-         mtx_unlock(&ks->mutex);
-         goto out;
-      }
-      for (unsigned i = 0; i < PANVK_KBASE_SYNC_TARGET_COUNT; i++) {
-         if (!ks->targets[i])
-            continue;
-         if (!ks->target_addrs[i]) {
-            count = UINT32_MAX;
-            break;
-         }
-         addrs[count] = ks->target_addrs[i];
-         vals[count++] = ks->targets[i] - 1;
-      }
-   }
-   mtx_unlock(&ks->mutex);
-
-   if (count == UINT32_MAX) {
-      result = kbase_cpu_sync_wait_one(device, ks, VK_SYNC_WAIT_COMPLETE,
-                                       UINT64_MAX);
-      if (result != VK_SUCCESS)
-         return result;
-      count = 0;
-   }
-
-   fd = kbase_kmod_csf_export_cqs64_fence(dev->kmod.dev, addrs, vals,
-                                          count);
-
-out:
-   if (fd < 0) {
-      if (errno == EMFILE || errno == ENFILE)
-         return vk_errorf(device, VK_ERROR_TOO_MANY_OBJECTS,
-                          "sync_file export failed: %m");
-      return vk_errorf(device, VK_ERROR_OUT_OF_HOST_MEMORY,
-                       "sync_file export failed: %m");
-   }
-
-   *sync_file = fd;
+   *sync_file = -1;
    return VK_SUCCESS;
 }
 
